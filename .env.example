# Supabase (öffentlich unbedenklich, RLS schützt die Daten)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Nur für scripts/create-user.mjs (lokal), nie im Client, nie bei Vercel nötig
SUPABASE_SECRET_KEY=sb_secret_xxx

# KI-Bewertung, nur serverseitig (Google AI Studio, bei Vercel als Secret)
# GEMINI_API_KEY=xxx
# Optional, Standard: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
